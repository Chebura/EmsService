{
  // HTTP endpoint of the web UI (HTTPS is not used). The UI has no authentication, so it listens on localhost only;
  // use "http://0.0.0.0:5080" to open it to the network.
  "Urls": "http://localhost:5080",
  // EMS settings file edited through the web UI (relative to the application directory).
  "EmsSettingsFilePath": "emssettings.json",
  "AllowedHosts": "*"
}
